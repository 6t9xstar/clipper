# Copy to .env and adjust. All variables are optional; defaults shown. Full reference: docs/configuration.md
# Where the database, media and exports are stored. Use a drive with plenty of free space.
CLIPPER_DATA_DIR=data
# SQLAlchemy URL. Empty = SQLite file in CLIPPER_DATA_DIR. (PostgreSQL: experimental until v1.0)
CLIPPER_DATABASE_URL=
# Network. Keep 127.0.0.1 unless you put an authenticating reverse proxy in front (no built-in auth before v1.0).
CLIPPER_HOST=127.0.0.1
CLIPPER_PORT=8765
CLIPPER_ALLOWED_HOSTS=["127.0.0.1","localhost"]
# Logging (JSON lines on stderr; transcripts and file names are never logged)
CLIPPER_LOG_LEVEL=INFO
CLIPPER_LOG_JSON=true
# Background jobs
CLIPPER_JOB_LEASE_SECONDS=60
CLIPPER_JOB_MAX_ATTEMPTS=3
CLIPPER_JOB_RETRY_BACKOFF_SECONDS=[30,120,600]
CLIPPER_WORKER_POLL_SECONDS=1.0
CLIPPER_WORKER_CONCURRENCY=1
# AI analysis. Models download once from Hugging Face into CLIPPER_DATA_DIR/models on first use.
# auto = large-v3-turbo on an NVIDIA GPU, small on CPU
CLIPPER_ASR_MODEL=auto
CLIPPER_ASR_DEVICE=auto
CLIPPER_ASR_CPU_THREADS=0
# Limits (enforced from M2: media import)
CLIPPER_MAX_UPLOAD_BYTES=21474836480
CLIPPER_MAX_DURATION_SECONDS=14400
CLIPPER_TEMP_RETENTION_HOURS=24
